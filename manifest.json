{
  "id": "zero.vault",
  "name": "Vault",
  "version": "2.0.1",
  "description": "Adult content for Zero Media — password-gated catalog + search (ThePornDB metadata; Zilean / Torznab / apiJAV / Rapidgator sourcing; on-demand debrid playback). Stays fully isolated from every normal library. Installing reveals the Adult library kind, the Adult sources section, and the ThePornDB credential.",
  "resources": [
    "catalog",
    "search",
    "meta",
    "artwork",
    "stream",
    "resolve",
    "automation"
  ],
  "types": [
    "adult",
    "person"
  ],
  "idPrefixes": [
    "tpdb:",
    "performer:"
  ],
  "provides": {
    "content": [
      "adult"
